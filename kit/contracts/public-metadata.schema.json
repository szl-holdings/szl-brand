{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:szl:public-metadata:v1",
  "title": "SZL public surface metadata",
  "description": "Fail-closed metadata for investor, developer, and evidence surfaces.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}(?::[0-9]{1,5})?(?:/[^\\s]*)?$"
    }
  },
  "required": [
    "title",
    "description",
    "canonicalUrl",
    "surface",
    "status",
    "sourceUrl",
    "evidenceUrl"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 8, "maxLength": 70 },
    "description": { "type": "string", "minLength": 24, "maxLength": 180 },
    "canonicalUrl": { "$ref": "#/$defs/httpsUrl" },
    "surface": {
      "type": "string",
      "enum": ["product", "documentation", "github", "huggingface", "research"]
    },
    "status": {
      "type": "string",
      "enum": ["REAL", "MEASURED", "MODELED", "ROADMAP", "UNAVAILABLE"]
    },
    "sourceUrl": { "$ref": "#/$defs/httpsUrl" },
    "evidenceUrl": { "$ref": "#/$defs/httpsUrl" },
    "imageUrl": { "$ref": "#/$defs/httpsUrl" },
    "lastVerified": { "type": "string", "format": "date-time" }
  }
}
