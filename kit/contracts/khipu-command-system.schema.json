{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:szl:khipu-command-system:v1",
  "title": "KHIPU Command System surface contract",
  "description": "Machine-readable disclosure for a responsive KANCHAY command surface.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/(?:[A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2})*)*(?:\\?(?:[A-Za-z0-9._~!$&'()*+,;=:@/?-]|%[0-9A-Fa-f]{2})*)?(?:#(?:[A-Za-z0-9._~!$&'()*+,;=:@/?-]|%[0-9A-Fa-f]{2})*)?$"
    },
    "shortText": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180,
      "pattern": "^(?=[^\\s\\u0085\\uFEFF\\u0000-\\u001F\\u007F])(?:[^\\u0000-\\u001F\\u007F]*[^\\s\\u0085\\uFEFF\\u0000-\\u001F\\u007F])?$"
    },
    "rfc3339Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29|(?:(?!0000)[0-9]{4})-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])"
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "evidenceClass",
        "operationalState",
        "sourceUrl",
        "scope",
        "limitations"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240,
          "pattern": "^(?=[^\\s\\u0085\\uFEFF\\u0000-\\u001F\\u007F])(?:[^\\u0000-\\u001F\\u007F]*[^\\s\\u0085\\uFEFF\\u0000-\\u001F\\u007F])?$"
        },
        "evidenceClass": {
          "type": "string",
          "enum": ["REAL", "MEASURED", "MODELED", "ROADMAP", "UNAVAILABLE"]
        },
        "operationalState": {
          "type": "string",
          "enum": ["OPERATIONAL", "PARTIAL", "DEGRADED", "UNAVAILABLE", "HISTORICAL"]
        },
        "sourceUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "observedAt": {
          "$ref": "#/$defs/rfc3339Timestamp"
        },
        "scope": {
          "type": "string",
          "minLength": 8,
          "maxLength": 300,
          "pattern": "^(?=[^\\s\\u0085\\uFEFF\\u0000-\\u001F\\u007F])(?:[^\\u0000-\\u001F\\u007F]*[^\\s\\u0085\\uFEFF\\u0000-\\u001F\\u007F])?$"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 240,
            "pattern": "^(?=[^\\s\\u0085\\uFEFF\\u0000-\\u001F\\u007F])(?:[^\\u0000-\\u001F\\u007F]*[^\\s\\u0085\\uFEFF\\u0000-\\u001F\\u007F])?$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "operationalState": {
                    "enum": ["OPERATIONAL", "PARTIAL", "DEGRADED", "HISTORICAL"]
                  }
                },
                "required": ["operationalState"]
              },
              {
                "properties": {
                  "evidenceClass": {
                    "const": "MEASURED"
                  }
                },
                "required": ["evidenceClass"]
              }
            ]
          },
          "then": {
            "required": ["observedAt"]
          }
        },
        {
          "if": {
            "properties": {
              "evidenceClass": {
                "enum": ["ROADMAP", "UNAVAILABLE"]
              }
            },
            "required": ["evidenceClass"]
          },
          "then": {
            "properties": {
              "operationalState": {
                "const": "UNAVAILABLE"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "contract",
    "recordKind",
    "surfaceId",
    "audience",
    "source",
    "responsive",
    "accessibility",
    "executiveBrief",
    "evidence",
    "links"
  ],
  "properties": {
    "contract": {
      "const": "szl.khipu-command-system/v1"
    },
    "recordKind": {
      "type": "string",
      "enum": ["SAMPLE", "RELEASE"]
    },
    "surfaceId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64
    },
    "audience": {
      "type": "string",
      "enum": ["EXECUTIVE", "OPERATOR", "BUILDER", "VERIFIER"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "kanchayManifestRoot"],
      "properties": {
        "repository": {
          "$ref": "#/$defs/httpsUrl"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "kanchayManifestRoot": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "responsive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testedViewportsCssPx", "zoomPercent", "bodyMeasureCh"],
      "properties": {
        "testedViewportsCssPx": {
          "type": "array",
          "prefixItems": [
            { "const": 360 },
            { "const": 390 },
            { "const": 768 },
            { "const": 1024 },
            { "const": 1440 }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        },
        "zoomPercent": {
          "type": "array",
          "prefixItems": [
            { "const": 200 },
            { "const": 400 }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "bodyMeasureCh": {
          "type": "integer",
          "minimum": 60,
          "maximum": 78
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumTargetCssPx",
        "focusVisible",
        "keyboardOnly",
        "reducedMotion",
        "nonColorStatus",
        "semanticLandmarks"
      ],
      "properties": {
        "minimumTargetCssPx": {
          "const": 44
        },
        "focusVisible": {
          "const": true
        },
        "keyboardOnly": {
          "const": true
        },
        "reducedMotion": {
          "const": true
        },
        "nonColorStatus": {
          "const": true
        },
        "semanticLandmarks": {
          "const": true
        }
      }
    },
    "executiveBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "primaryAudience",
        "outcome",
        "primaryAction",
        "evidenceAction",
        "boundary"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/shortText"
        },
        "primaryAudience": {
          "$ref": "#/$defs/shortText"
        },
        "outcome": {
          "$ref": "#/$defs/shortText"
        },
        "primaryAction": {
          "$ref": "#/$defs/shortText"
        },
        "evidenceAction": {
          "$ref": "#/$defs/shortText"
        },
        "boundary": {
          "type": "string",
          "minLength": 12,
          "maxLength": 240,
          "pattern": "^(?=[^\\s\\u0085\\uFEFF\\u0000-\\u001F\\u007F])(?:[^\\u0000-\\u001F\\u007F]*[^\\s\\u0085\\uFEFF\\u0000-\\u001F\\u007F])?$"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "documentation", "source", "evidence"],
      "properties": {
        "product": {
          "$ref": "#/$defs/httpsUrl"
        },
        "documentation": {
          "$ref": "#/$defs/httpsUrl"
        },
        "source": {
          "$ref": "#/$defs/httpsUrl"
        },
        "evidence": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "recordKind": {
            "const": "RELEASE"
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "revision": {
                "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
              },
              "kanchayManifestRoot": {
                "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordKind": {
            "const": "SAMPLE"
          }
        },
        "required": ["recordKind"]
      },
      "then": {
        "properties": {
          "evidence": {
            "items": {
              "properties": {
                "operationalState": {
                  "enum": ["UNAVAILABLE", "HISTORICAL"]
                }
              }
            }
          }
        }
      }
    }
  ]
}
